# Created by install.sh / setup.sh with random secrets. The inverter connection is
# set up in the web page at http://<pi>:8088, not here.

# Password for the setup page and Grafana (user: admin)
ADMIN_PASSWORD=change-me

# Login for the optional built-in MQTT broker (see enable-broker.sh). Not used when
# the monitor sends to Home Assistant's own broker, chosen on the setup page.
MQTT_USER=deye
MQTT_PASSWORD=change-me

INFLUX_ORG=home
INFLUX_BUCKET=deye
INFLUX_TOKEN=change-me
INFLUX_ADMIN_PASSWORD=change-me

DEVICE_ID=deye

# Set by enable-broker.sh to run the built-in broker. Leave unset otherwise.
#COMPOSE_PROFILES=broker
#MQTT_HOST=localhost

# Ports on the Pi. setup.sh moves any that are already taken (OctoPi uses 8080).
WEB_PORT=8088
GRAFANA_PORT=3000
MQTT_PORT=1883
INFLUX_PORT=8086

# Optional: preset the connection instead of using the setup page
#DEYE_TRANSPORT=solarman        # or rs485
#LOGGER_IP=192.168.1.50
#LOGGER_SERIAL=2712345678
#DEYE_SLAVE_ID=1
