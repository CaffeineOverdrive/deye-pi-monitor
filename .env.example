# Copy to .env (setup.sh does this and fills in random secrets)

# USB-RS485 adapter. Prefer the stable /dev/serial/by-id/... path over /dev/ttyUSB0.
DEYE_SERIAL_DEVICE=/dev/ttyUSB0
DEYE_SLAVE_ID=1
DEYE_BAUDRATE=9600
POLL_SECONDS=10
DEVICE_ID=deye

INFLUX_ORG=home
INFLUX_BUCKET=deye
INFLUX_TOKEN=change-me
INFLUX_ADMIN_PASSWORD=change-me

GRAFANA_ADMIN_PASSWORD=change-me

# Home Assistant connects to the Pi's Mosquitto with these credentials
MQTT_USER=deye
MQTT_PASSWORD=change-me
