# Created by install.sh / setup.sh with random secrets. The inverter connection is
# set up in the web page at http://<pi>:8088, not here.

# Password for the setup page and Grafana (user: admin)
ADMIN_PASSWORD=change-me

# Home Assistant connects to the Pi's MQTT broker with these
MQTT_USER=deye
MQTT_PASSWORD=change-me

INFLUX_ORG=home
INFLUX_BUCKET=deye
INFLUX_TOKEN=change-me
INFLUX_ADMIN_PASSWORD=change-me

DEVICE_ID=deye

# Ports on the Pi. setup.sh moves any that are already taken (OctoPi uses 8080).
WEB_PORT=8088
GRAFANA_PORT=3000
MQTT_PORT=1883
INFLUX_PORT=8086

# Optional: preset the connection instead of using the setup page
#DEYE_TRANSPORT=solarman        # or rs485
#LOGGER_IP=192.168.1.50
#LOGGER_SERIAL=2712345678
#DEYE_SLAVE_ID=1
