    {
      "id": 11,
      "type": "stat",
      "title": "Self-sufficiency today",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-deye"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-deye"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"inverter\" and (r._field == \"day_load_energy\" or r._field == \"day_grid_import\"))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"_measurement\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, \"self_sufficiency\": if r.day_load_energy > 0.0 then 100.0 * (r.day_load_energy - r.day_grid_import) / r.day_load_energy else 0.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
